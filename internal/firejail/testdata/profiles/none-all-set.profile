# Generated by Jailcat. Do not edit: change it in Jailcat and rebuild.
# jailcat-build: 7
quiet

# Settings
noblacklist ${DOWNLOADS}
whitelist ${DOWNLOADS}
noblacklist ${HOME}/Projects
whitelist ${HOME}/Projects
noblacklist /mnt/ro
whitelist /mnt/ro
read-only /mnt/ro
blacklist /mnt/secret
disable-mnt
noexec ${HOME}
private-tmp
private-dev
private-cache
net none
dns 1.1.1.1
hosts-file /etc/hosts.probe
netfilter
nosound
novideo
no3d
noprinters
nou2f
noinput
nodvd
notv
notpm
dbus-user filter
dbus-user.talk org.probe.Talk
dbus-user.own org.probe.Own
dbus-system filter
x11 xvfb
seccomp
caps.drop all
nonewprivs
noroot
restrict-namespaces
memory-deny-write-execute
landlock.enforce
include ${CFG}/landlock-common.inc
protocol unix
private-bin probe
private-etc probe
env PROBE=1
rlimit-as 1
cpu 0
nice 1
timeout 00:00:01
rlimit-nofile 1
rlimit-nproc 1
join-or-start firejail-test
