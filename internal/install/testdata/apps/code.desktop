[Desktop Entry]
Name=Visual Studio Code
Name[de]=Visual Studio Code
GenericName=Text Editor
GenericName[de]=Texteditor
Comment=Code Editing. Redefined.
Exec=code %F
Icon=code
Type=Application
StartupNotify=true
StartupWMClass=Code
Categories=Utility;TextEditor;Development;IDE;
MimeType=application/x-code-workspace;text/plain;
Actions=new-empty-window;open-docs;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Name[de]=Neues leeres Fenster
Name[es]=Nueva ventana vacía
Exec=code --new-window %F
Icon=code

[Desktop Action open-docs]
Name=Open the Documentation
Exec=xdg-open https://code.visualstudio.com/docs
